# Copy to tom.env (repo root) to override defaults. All keys are optional.

# TOM_LLM_MODEL=models/llm/qwen2.5-3b-instruct-q4_k_m.gguf
# TOM_LLM_GPU_LAYERS=-1          # -1 = all layers on GPU (needs a CUDA build of llama-cpp-python)
# TOM_LLM_CONTEXT=4096
# TOM_WHISPER_DEVICE=auto        # auto | cpu | cuda
# TOM_STT_SILENCE_SECONDS=1.0
# TOM_STT_USE_VAD=true

# TOM_MONGO_URI=mongodb://localhost:27017/
# TOM_MONGO_DB=talking_tom

# The dashboard API only listens on this machine by default.
# Only change this if every account has a password.
# TOM_API_HOST=127.0.0.1
# TOM_API_PORT=8000
# TOM_API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# TOM_DEFAULT_USER_NAME=Hari
# TOM_LOG_LEVEL=INFO
